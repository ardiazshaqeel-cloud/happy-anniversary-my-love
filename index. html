<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Anniversary My Love</title>
    <style>
        /* Desain Umum */
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #ffe3e3 0%, #ffd1d1 100%);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            color: #4a4a4a;
        }

        .card {
            background: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
            max-width: 400px;
            width: 85%;
            backdrop-filter: blur(5px);
            transition: all 0.5s ease;
            z-index: 10;
        }

        h2 {
            color: #ff4d6d;
            margin-bottom: 20px;
        }

        /* Halaman Login / Password */
        #login-screen input {
            width: 80%;
            padding: 12px;
            border: 2px solid #ffb3c1;
            border-radius: 25px;
            outline: none;
            font-size: 16px;
            text-align: center;
            transition: 0.3s;
        }

        #login-screen input:focus {
            border-color: #ff4d6d;
        }

        button {
            margin-top: 15px;
            background: #ff4d6d;
            color: white;
            border: none;
            padding: 10px 25px;
            border-radius: 25px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
            box-shadow: 0 4px 15px rgba(255, 77, 109, 0.3);
        }

        button:hover {
            background: #ff758f;
            transform: translateY(-2px);
        }

        #error-msg {
            color: #ff0000;
            font-size: 14px;
            margin-top: 10px;
            display: none;
        }

        /* Halaman Utama (Konten) */
        #main-content {
            display: none;
            opacity: 0;
            transform: scale(0.9);
            transition: all 0.8s ease;
        }

        .love-letter {
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 20px;
            text-align: justify;
        }

        .highlight {
            font-weight: bold;
            color: #ff4d6d;
        }

        /* Animasi Hati Berjatuhan */
        .heart {
            position: absolute;
            color: #ff4d6d;
            font-size: 20px;
            position: fixed;
            top: -10%;
            user-select: none;
            z-index: 1;
            animation: fall linear infinite;
        }

        @keyframes fall {
            0% { top: -10%; transform: translateX(0) rotate(0deg); opacity: 1; }
            100% { top: 110%; transform: translateX(100px) rotate(360deg); opacity: 0; }
        }
    </style>
</head>
<body>

    <!-- SCREEN 1: Kunci Password -->
    <div id="login-screen" class="card">
        <h2>Open Your Gift 🎁</h2>
        <p>Masukkan kode rahasia untuk membuka isi pesan:</p>
        <input type="password" id="password-input" placeholder="Ketik kode di sini...">
        <br>
        <button onclick="checkPassword()">Buka</button>
        <p id="error-msg">Wah, kodenya salah nih. Coba lagi ya! ❤️</p>
    </div>

    <!-- SCREEN 2: Konten Ucapan Manis -->
    <div id="main-content" class="card">
        <h2>Happy Anniversary! ❤️</h2>
        <div class="love-letter">
            <p>Hai sayang,</p>
            <p>Selamat hari jadi kita! Gak kerasa ya waktu berjalan begitu cepat kalau dilewati bareng kamu. Makasih banyak ya udah selalu ada, selalu sabar, dan selalu jadi alasan aku buat tersenyum setiap hari.</p>
            <p>Aku bersyukur banget punya kamu di hidup aku. Semoga ke depannya kita bisa terus saling menjaga, saling melengkapi, dan melewati banyak hal bahagia bareng-bareng lagi.</p>
            <p class="highlight" style="text-align: center; font-size: 18px; margin-top: 20px;">I love you more than words can say. ✨</p>
        </div>
        <button onclick="tambahHati()">Kirim Cinta lagi ciiiaa</button>
    </div>

    <script>
        // Fungsi Cek Password
        function checkPassword() {
            const input = document.getElementById('password-input').value.toLowerCase().trim();
            const loginScreen = document.getElementById('login-screen');
            const mainContent = document.getElementById('main-content');
            const errorMsg = document.getElementById('error-msg');

            // Password sesuai request: "aishiteru"
            if (input === "aishiteru") {
                loginScreen.style.display = "none";
                mainContent.style.display = "block";
                
                // Efek smooth muncul
                setTimeout(() => {
                    mainContent.style.opacity = "1";
                    mainContent.style.transform = "scale(1)";
                }, 50);

                // Jalankan animasi hati berjatuhan
                setInterval(createHeart, 300);
            } else {
                errorMsg.style.display = "block";
                document.getElementById('password-input').value = "";
            }
        }

        // Izinkan tekan 'Enter' untuk submit
        document.getElementById('password-input').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                checkPassword();
            }
        });

        // Fungsi Animasi Hati
        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('heart');
            heart.innerHTML = '❤️';
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = Math.random() * 3 + 2 + 's';
            heart.style.fontSize = Math.random() * 20 + 10 + 'px';
            document.body.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 5000);
        }

        function tambahHati() {
            for(let i=0; i<10; i++) {
                setTimeout(createHeart, i * 100);
            }
        }
    </script>
</body>
</html>
